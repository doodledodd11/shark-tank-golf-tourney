# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Database -----------------------------------------------------------
# Local development uses a SQLite file — zero setup required.
# For production, point this at a Postgres connection string (Neon or
# Supabase both work well). See README.md "Database" section for the
# one-line change needed to switch providers.
DATABASE_URL="file:./dev.db"

# --- Admin auth -----------------------------------------------------------
# Plaintext password used to sign in at /admin/login. Pick something long;
# it is compared server-side only and is never sent to the browser bundle.
ADMIN_PASSWORD="change-me-before-deploying"

# Random secret used to sign the admin session cookie (HMAC key). Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"
