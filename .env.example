# Copy this file to .env and fill in real values. Never commit .env.
#
# --- Database -----------------------------------------------------------
# Postgres everywhere, via Neon (https://neon.tech) — locally too, not just
# in production. The project uses Neon's branching feature: a "development"
# branch for local work and a "production" branch for the live site, both
# under one Neon project, both provisioned from the same schema/migrations.
# Get a connection string from your Neon project's dashboard (use the
# pooled "-pooler" host — it's the one that scales safely with serverless
# deployments) and set it per environment: your local .env points at the
# development branch; Vercel's Production environment variable points at
# the production branch. See README.md "Database" for the full setup.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Admin auth -----------------------------------------------------------
# Plaintext password used to sign in at /admin/login. Pick something long;
# it is compared server-side only and is never sent to the browser bundle.
# Use a different value per environment — never reuse your local dev
# password in production.
ADMIN_PASSWORD="change-me-before-deploying"

# Random secret used to sign the admin session cookie (HMAC key). Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value per environment, same reasoning as ADMIN_PASSWORD.
SESSION_SECRET="replace-with-a-long-random-string"
