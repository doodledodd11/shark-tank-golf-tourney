{
  "name": "golf-tourney",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shark Tank Golf Invitational — tournament website",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
